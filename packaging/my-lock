#!/usr/bin/env bash
# Starts the lock screen. Put this in ~/.local/bin/my-lock.
#
# The locker is a separate process rather than part of the shell: if the shell
# restarts or crashes, the lock has to stay on screen. Running it twice is
# harmless — AGS sees the instance already running and exits.

usage() {
  cat <<'EOF'
usage: my-lock [-s SECONDS|never]

  -s, --suspend-after SECONDS
        How long the lock screen stays up before the machine is suspended.
        Default 60. 0 suspends at once, `never` leaves the machine awake
        behind the lock. A key press always holds the sleep off a while
        longer, so it cannot happen mid-password.
EOF
}

# The countdown itself belongs to the locker — see lock/services/suspend.ts for
# why. This only checks the value and passes it on, because a typo is worth a
# word here and now rather than a machine that quietly never sleeps.
delay="${MY_LOCK_SUSPEND_DELAY:-}"

while (( $# )); do
  case $1 in
    -s | --suspend-after)
      delay="${2-}"
      [[ -n "$delay" ]] || { echo "my-lock: $1 needs a value" >&2; exit 2; }
      shift 2
      ;;
    -h | --help) usage; exit 0 ;;
    *) echo "my-lock: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -n "$delay" ]]; then
  if [[ ! "$delay" =~ ^([0-9]+|never)$ ]]; then
    echo "my-lock: --suspend-after wants whole seconds or 'never', not '$delay'" >&2
    exit 2
  fi
  export MY_LOCK_SUSPEND_DELAY="$delay"
fi

# Render at more than 8 bits per channel where the hardware allows it, so the
# scrim gradient does not band into visible strips. See the same setting, with
# the full reasoning, in packaging/hypr/greeter.lua.
export GDK_DEBUG="${GDK_DEBUG:-high-depth}"

exec ags run "${MY_GREETER_DIR:-$HOME/Projects/myGreeter}/lock/app.ts"
