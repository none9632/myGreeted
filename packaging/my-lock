#!/usr/bin/env bash
# Запуск экрана блокировки. Положить в ~/.local/bin/my-lock.
#
# Блокировщик — отдельный процесс, а не часть шелла: если шелл перезапустится
# или упадёт, блокировка должна остаться на экране. Второй запуск безвреден —
# AGS увидит уже работающий инстанс и выйдет.

exec ags run "${MY_GREETER_DIR:-$HOME/Projects/myGreeter}/lock/app.ts"
